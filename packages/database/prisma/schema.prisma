// SpecAI domain schema: heavy equipment rental & construction services platform.
generator client {
  provider      = "prisma-client-js"
  output        = "../generated/client"
  // Vercel functions run on Amazon Linux 2023; ship that engine whatever the build host is.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // Runtime queries go through the pooled connection (e.g. Neon's PgBouncer
  // endpoint) for serverless-friendly connection reuse. Schema pushes and
  // migrations need a direct connection instead — DDL over a transaction-mode
  // pooler is unreliable. Point DIRECT_URL at the same database without the
  // pooler (locally, both vars can just be identical).
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

enum UserRole {
  CUSTOMER // rents equipment / hires services
  PROVIDER_ADMIN // manages a provider company's fleet and bookings
  PROVIDER_OPERATOR // drives/operates equipment on behalf of a provider
  PLATFORM_ADMIN // internal SpecAI staff
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String
  phone             String?
  role              UserRole  @default(CUSTOMER)
  passwordHash      String?
  /// Момент последней смены пароля: JWT, выданные раньше, считаются недействительными.
  passwordChangedAt DateTime?
  emailVerified     DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  company   Company? @relation(fields: [companyId], references: [id])
  companyId String?

  // «Пригласи коллегу»: the user's own code (/r/<code>) and who invited them.
  // No @unique: adding a unique constraint makes the build-time `db push`
  // stop for confirmation; codes are random and checked in lib/referralStore.ts.
  referralCode String?
  referredById String?

  bookings           Booking[]           @relation("BookingCustomer")
  orders             Order[]             @relation("OrderCustomer")
  reviews            Review[]
  aiConversations    AiConversation[]
  verificationTokens VerificationToken[]
  commentsWritten    Comment[]           @relation("CommentAuthor")
  commentsReceived   Comment[]           @relation("CommentTarget")
  operator           Operator?

  @@index([companyId])
  @@index([referralCode])
  @@index([referredById])
}

enum VerificationTokenType {
  PASSWORD_RESET
  EMAIL_VERIFY
}

// One-time tokens for password reset and email verification. `token` holds the
// sha256 hash of the raw token that was emailed to the user, never the raw value.
model VerificationToken {
  id        String                @id @default(cuid())
  token     String                @unique
  type      VerificationTokenType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime              @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([userId])
}

// A Company can be an equipment provider (rental fleet owner), a customer
// organization, or both — `isProvider` distinguishes fleet-owning companies.
model Company {
  id          String   @id @default(cuid())
  name        String
  isProvider  Boolean  @default(false)
  taxId       String?
  phone       String?
  website     String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  location   Location? @relation(fields: [locationId], references: [id])
  locationId String?

  // Aggregator map: where the provider's fleet is based, the marker picture
  // (a photo of its machinery; empty = the default icon) and a short note
  // customers see on the map ("от 2 500 ₽/ч, скидка 10% на неделю").
  baseLat     Float?
  baseLon     Float?
  baseAddress String?
  pinImageUrl String?
  pinNote     String?
  // «Проверен»: the admin checked the company (ИНН, documents, a call).
  verified    Boolean @default(false)

  users     User[]
  equipment Equipment[]
  reviews   Review[]
  comments  Comment[]
  operators Operator[]

  @@index([locationId])
}

model Location {
  id          String   @id @default(cuid())
  addressLine String
  city        String
  region      String?
  postalCode  String?
  country     String
  latitude    Float?
  longitude   Float?
  createdAt   DateTime @default(now())

  companies Company[]
  equipment Equipment[]
  bookings  Booking[]
  orders    Order[]
}

// ---------------------------------------------------------------------------
// Equipment catalog
// ---------------------------------------------------------------------------

model EquipmentCategory {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  description String?

  parent   EquipmentCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  parentId String?
  children EquipmentCategory[] @relation("CategoryHierarchy")

  equipment Equipment[]
  orders    Order[]

  @@index([parentId])
}

enum EquipmentStatus {
  AVAILABLE
  RENTED
  IN_MAINTENANCE
  RETIRED
}

model Equipment {
  id          String          @id @default(cuid())
  name        String
  make        String?
  model       String?
  year        Int?
  status      EquipmentStatus @default(AVAILABLE)
  dailyRate   Decimal         @db.Decimal(10, 2)
  // Hourly rate (machine-hour), the usual unit for machinery with an operator.
  // When set, it is shown as the headline price; dailyRate is then an 8-hour shift.
  hourlyRate  Decimal?        @db.Decimal(10, 2)
  weeklyRate  Decimal?        @db.Decimal(10, 2)
  monthlyRate Decimal?        @db.Decimal(10, 2)
  currency    String          @default("RUB")
  // Free-form technical specifications (capacity, horsepower, dimensions, etc.).
  // Kept schemaless because spec fields vary wildly across equipment types;
  // AI spec-extraction populates this from manufacturer sheets/photos.
  specs       Json?
  description String?
  imageUrls   String[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  category   EquipmentCategory @relation(fields: [categoryId], references: [id])
  categoryId String

  company   Company @relation(fields: [companyId], references: [id])
  companyId String

  location   Location? @relation(fields: [locationId], references: [id])
  locationId String?

  bookings           Booking[]
  bids               Bid[]
  maintenanceRecords MaintenanceRecord[]
  reviews            Review[]
  documents          Document[]
  blocks             EquipmentBlock[]

  @@index([categoryId])
  @@index([companyId])
  @@index([locationId])
  @@index([status])
}

model MaintenanceRecord {
  id          String   @id @default(cuid())
  performedAt DateTime
  description String
  cost        Decimal? @db.Decimal(10, 2)
  createdAt   DateTime @default(now())

  equipment   Equipment @relation(fields: [equipmentId], references: [id])
  equipmentId String

  @@index([equipmentId])
}

// ---------------------------------------------------------------------------
// Bookings / rentals
// ---------------------------------------------------------------------------

enum BookingStatus {
  PENDING
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
}

model Booking {
  id          String        @id @default(cuid())
  status      BookingStatus @default(PENDING)
  startDate   DateTime
  endDate     DateTime
  totalPrice  Decimal       @db.Decimal(10, 2)
  currency    String        @default("RUB")
  depositPaid Boolean       @default(false)
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  equipment   Equipment @relation(fields: [equipmentId], references: [id])
  equipmentId String

  customer   User   @relation("BookingCustomer", fields: [customerId], references: [id])
  customerId String

  deliveryLocation   Location? @relation(fields: [deliveryLocationId], references: [id])
  deliveryLocationId String?

  // Set when this booking was created by accepting a Bid on an Order,
  // rather than the customer booking a specific listing directly.
  order   Order?  @relation(fields: [orderId], references: [id])
  orderId String? @unique

  documents  Document[]
  review     Review?
  payment    Payment?
  operatorId String?
  operator   Operator?  @relation(fields: [operatorId], references: [id])
  shifts     Shift[]

  @@index([equipmentId])
  @@index([customerId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Payments (Stripe Checkout)
// ---------------------------------------------------------------------------

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// One payment per booking. Created when the customer starts Stripe Checkout;
// flipped to PAID by the Stripe webhook, which also confirms the booking.
model Payment {
  id                      String        @id @default(cuid())
  amount                  Decimal       @db.Decimal(10, 2)
  currency                String        @default("USD")
  status                  PaymentStatus @default(PENDING)
  // Paid, but the booking was cancelled afterwards: refund manually in the
  // Stripe Dashboard. A column rather than an enum value because adding an
  // enum value (ALTER TYPE ... ADD VALUE) cannot run through a transaction
  // pooler, which is how `db push` reaches the hosted database.
  refundRequired          Boolean       @default(false)
  stripeCheckoutSessionId String?       @unique
  stripePaymentIntentId   String?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  booking   Booking @relation(fields: [bookingId], references: [id])
  bookingId String  @unique

  @@index([status])
}

// ---------------------------------------------------------------------------
// Dispatch: customer posts a job, nearby providers bid on it
// ---------------------------------------------------------------------------

enum OrderStatus {
  // Imported from a messenger chat, waiting for the admin to publish it.
  PENDING_REVIEW
  OPEN
  MATCHED
  CANCELLED
}

// A customer's job request ("need an excavator in Yekaterinburg next week")
// posted without picking a specific listing up front — the taxi-style
// counterpart to browsing the catalog and booking directly.
model Order {
  id               String      @id @default(cuid())
  description      String
  desiredStartDate DateTime
  desiredEndDate   DateTime
  status           OrderStatus @default(OPEN)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  customer   User   @relation("OrderCustomer", fields: [customerId], references: [id])
  customerId String

  category   EquipmentCategory? @relation(fields: [categoryId], references: [id])
  categoryId String?

  location   Location? @relation(fields: [locationId], references: [id])
  locationId String?

  bids    Bid[]
  booking Booking?

  // Orders collected automatically from Telegram/WhatsApp chats and groups.
  // For those, `customer` is a technical importer user and the real contact
  // is kept in contactName/contactPhone (shown only to providers and admins).
  source       OrderSource @default(SITE)
  // "telegram:<chat>:<message>". Not @unique on purpose: adding a unique
  // constraint makes the build-time `db push` stop for confirmation. Dedupe
  // is done in code (lib/ingest.ts).
  externalId   String?
  fingerprint  String? // normalized text — spots reposts across chats
  sourceChat   String?
  sourceUrl    String?
  contactName  String?
  contactPhone String?
  rawText      String?

  @@index([customerId])
  @@index([categoryId])
  @@index([status])
  @@index([fingerprint])
  @@index([externalId])
}

enum OrderSource {
  SITE
  TELEGRAM
  WHATSAPP
  OTHER
}

enum BidStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// A provider's offer against an Order: a specific piece of equipment at a
// quoted price. Accepting a bid turns it into a Booking.
model Bid {
  id        String    @id @default(cuid())
  price     Decimal   @db.Decimal(10, 2)
  currency  String    @default("RUB")
  message   String?
  status    BidStatus @default(PENDING)
  createdAt DateTime  @default(now())

  order   Order  @relation(fields: [orderId], references: [id])
  orderId String

  equipment   Equipment @relation(fields: [equipmentId], references: [id])
  equipmentId String

  @@index([orderId])
  @@index([equipmentId])
}

enum DocumentType {
  CONTRACT
  INSURANCE_CERTIFICATE
  INSPECTION_REPORT
  INVOICE
  OTHER
}

model Document {
  id        String       @id @default(cuid())
  type      DocumentType
  fileUrl   String
  fileName  String
  createdAt DateTime     @default(now())

  booking   Booking? @relation(fields: [bookingId], references: [id])
  bookingId String?

  equipment   Equipment? @relation(fields: [equipmentId], references: [id])
  equipmentId String?

  @@index([bookingId])
  @@index([equipmentId])
}

model Review {
  id         String   @id @default(cuid())
  rating     Int
  comment    String?
  // The stars are shown at once; the text only after the owner approves it
  // in /admin: "PENDING" | "APPROVED" | "REJECTED" (a string, not an enum —
  // see CLAUDE.md, rule 2).
  textStatus String   @default("PENDING")
  createdAt  DateTime @default(now())

  author   User   @relation(fields: [authorId], references: [id])
  authorId String

  company   Company @relation(fields: [companyId], references: [id])
  companyId String

  equipment   Equipment? @relation(fields: [equipmentId], references: [id])
  equipmentId String?

  booking   Booking @relation(fields: [bookingId], references: [id])
  bookingId String  @unique

  @@index([companyId])
  @@index([equipmentId])
}

// ---------------------------------------------------------------------------
// AI assistant
// ---------------------------------------------------------------------------

enum AiConversationPurpose {
  EQUIPMENT_RECOMMENDATION
  SPEC_EXTRACTION
  GENERAL_SUPPORT
}

model AiConversation {
  id        String                @id @default(cuid())
  purpose   AiConversationPurpose @default(GENERAL_SUPPORT)
  createdAt DateTime              @default(now())

  user   User   @relation(fields: [userId], references: [id])
  userId String

  messages AiMessage[]

  @@index([userId])
}

enum AiMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model AiMessage {
  id        String        @id @default(cuid())
  role      AiMessageRole
  content   String
  // Structured payload for tool calls/results (e.g. recommended equipment ids).
  metadata  Json?
  createdAt DateTime      @default(now())

  conversation   AiConversation @relation(fields: [conversationId], references: [id])
  conversationId String

  @@index([conversationId])
}

// ---------------------------------------------------------------------------
// Leads: "call me back" requests from the public site
// ---------------------------------------------------------------------------

enum LeadStatus {
  NEW
  IN_PROGRESS
  DONE
}

// A visitor asking the company to call them back. Works without an account
// and without the AI features, so the site always captures enquiries.
model Lead {
  id         String     @id @default(cuid())
  name       String
  phone      String
  message    String?
  // Where the form was sent from (e.g. "home", "equipment:<id>", "agents").
  source     String?
  status     LeadStatus @default(NEW)
  // Owner's result: 'deal' | 'no_deal' | 'no_answer'. String, not an enum
  // (a new enum value breaks the deploy).
  outcome    String?
  // Deal amount, rubles.
  amount     Int?
  // Yandex Metrika ClientID (_ym_uid).
  ymClientId String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([status])
  @@index([createdAt])
}

// Comments about a provider (company) or a customer (user), published only
// after the owner approves them in /admin. status is a plain string
// ("PENDING" | "APPROVED" | "REJECTED") rather than an enum, so the schema
// can grow without ALTER TYPE (see CLAUDE.md, rule 2).
model Comment {
  id          String    @id @default(cuid())
  text        String
  status      String    @default("PENDING")
  createdAt   DateTime  @default(now())
  moderatedAt DateTime?

  author   User   @relation("CommentAuthor", fields: [authorId], references: [id])
  authorId String

  targetCompany   Company? @relation(fields: [targetCompanyId], references: [id])
  targetCompanyId String?

  targetUser   User?   @relation("CommentTarget", fields: [targetUserId], references: [id])
  targetUserId String?

  @@index([status])
  @@index([targetCompanyId])
  @@index([targetUserId])
}

// ---------------------------------------------------------------------------
// Notifications: channels each user picked, Telegram linking, app push tokens
// ---------------------------------------------------------------------------

// One row per user, created on the first change (no row = the defaults).
// userId is a plain column, not a relation, so the User model stays untouched.
model NotificationSettings {
  id                    String    @id @default(cuid())
  userId                String    @unique
  telegram              Boolean   @default(true)
  push                  Boolean   @default(true)
  email                 Boolean   @default(true)
  whatsapp              Boolean   @default(false)
  sms                   Boolean   @default(false)
  // Private chat with the bot, set by "/start <token>" (lib/notifications/telegramLink.ts).
  telegramChatId        String?
  // sha256 of the one-time token from the deep link, never the token itself.
  telegramLinkHash      String?
  telegramLinkExpiresAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([telegramLinkHash])
  @@index([telegramChatId])
}

// Expo push token of a signed-in device (several per user).
model PushToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  platform  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Log of «Показать телефон» on orders found in open chats: who saw the phone
// and when. Also the per-provider daily limit (lib/chatOrders.ts).
model ContactReveal {
  id        String   @id @default(cuid())
  orderId   String
  userId    String
  companyId String?
  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([orderId])
}

// ---- Shifts, timesheets, operators, calendar ----

// A machine operator («машинист») of a provider company. Managed by the
// company's PROVIDER_ADMIN; `userId` links the operator's own app sign-in
// (role PROVIDER_OPERATOR), which the admin creates with a temporary password.
model Operator {
  id            String   @id @default(cuid())
  name          String
  phone         String?
  licenseNumber String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company   Company @relation(fields: [companyId], references: [id])
  companyId String

  user   User?   @relation(fields: [userId], references: [id])
  userId String? @unique

  bookings Booking[]
  shifts   Shift[]

  @@index([companyId])
}

// One working day of a booking, driven by the operator from the app:
// Выехал → На объекте → Работа → Простой → Смена завершена. `status` is a
// string (see packages/shared/src/schemas/shift.ts), never an enum, so the
// list can grow without ALTER TYPE (CLAUDE.md, rule 2). One shift per booking
// per calendar day (`date` is UTC midnight of the Moscow day).
model Shift {
  id            String    @id @default(cuid())
  date          DateTime
  status        String    @default("PLANNED")
  startedAt     DateTime?
  arrivedAt     DateTime?
  workStartedAt DateTime?
  finishedAt    DateTime?
  startPhotoUrl String?
  endPhotoUrl   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  booking   Booking @relation(fields: [bookingId], references: [id])
  bookingId String

  operator   Operator? @relation(fields: [operatorId], references: [id])
  operatorId String?

  events    ShiftEvent[]
  timesheet Timesheet?

  @@unique([bookingId, date])
  @@index([operatorId])
}

// Every status change of a shift with its moment, an optional note (the
// reason of an idle period) and the photo taken at the start or the end.
model ShiftEvent {
  id       String   @id @default(cuid())
  kind     String
  at       DateTime @default(now())
  note     String?
  photoUrl String?

  shift   Shift  @relation(fields: [shiftId], references: [id])
  shiftId String

  @@index([shiftId, at])
}

// The shift's timesheet («табель»): hours worked and idle, filled by the
// operator or the provider after the shift and final only when BOTH the
// customer and the provider's admin have confirmed it.
model Timesheet {
  id                  String    @id @default(cuid())
  hoursWorked         Decimal   @db.Decimal(5, 2)
  idleHours           Decimal   @default(0) @db.Decimal(5, 2)
  note                String?
  customerConfirmedAt DateTime?
  providerConfirmedAt DateTime?
  disputedAt          DateTime?
  disputeNote         String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  shift   Shift  @relation(fields: [shiftId], references: [id])
  shiftId String @unique
}

// Days the provider took a machine off the calendar by hand («Не сдаётся»):
// bookings may not overlap them. Both ends inclusive, calendar days.
model EquipmentBlock {
  id        String   @id @default(cuid())
  from      DateTime
  to        DateTime
  reason    String?
  createdAt DateTime @default(now())

  equipment   Equipment @relation(fields: [equipmentId], references: [id])
  equipmentId String

  @@index([equipmentId, from])
}
