{
  "expo": {
    "name": "ИИСтройка24",
    "slug": "specai",
    "owner": "maratgalin1986s-team",
    "version": "0.1.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "specai",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.specai.app"
    },
    "android": {
      "package": "com.specai.specai",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#D97706"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Геопозиция нужна, чтобы заказчики видели вашу машину на линии, а вы — технику рядом.",
          "locationAlwaysAndWhenInUsePermission": "Фоновая геопозиция нужна, чтобы ваша машина оставалась на карте у заказчиков, пока вы на линии, даже с выключенным экраном.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Приложению нужен доступ к фото, чтобы добавлять снимки техники.",
          "cameraPermission": "Камера нужна, чтобы снять технику в начале и в конце смены."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#D97706",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#D97706"
        }
      ],
      "expo-task-manager"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e14d6fd4-d51a-4611-b084-e1da96f98879"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/e14d6fd4-d51a-4611-b084-e1da96f98879"
    }
  }
}
