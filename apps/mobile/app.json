{
  "expo": {
    "name": "СпецПласт16",
    "slug": "specai",
    "owner": "maratgalin1986s-team",
    "version": "0.1.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "specai",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.specai.app"
    },
    "android": {
      "package": "com.specai.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#D97706"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Приложению нужен доступ к фото, чтобы добавлять снимки техники."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#D97706",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e14d6fd4-d51a-4611-b084-e1da96f98879"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/e14d6fd4-d51a-4611-b084-e1da96f98879"
    }
  }
}
