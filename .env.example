# Postgres connection used by Prisma (packages/database).
# DATABASE_URL: used at runtime — point this at a pooled connection (e.g.
#   Neon's "-pooler" endpoint) in serverless deployments.
# DIRECT_URL: used for `prisma db push`/migrations — must be an unpooled
#   connection. Locally, with a single plain Postgres, both can be identical.
DATABASE_URL="postgresql://specai:specai@localhost:5432/specai?schema=public"
DIRECT_URL="postgresql://specai:specai@localhost:5432/specai?schema=public"

# Anthropic API key used by packages/ai-service
ANTHROPIC_API_KEY=""

# NextAuth (apps/web) — generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Vercel Blob (apps/web) — хранилище фото техники и PDF-спецификаций.
# Получить токен: Vercel Dashboard → ваш проект → Storage → Create Database → Blob,
# затем скопировать BLOB_READ_WRITE_TOKEN из вкладки ".env.local" (или подключить
# store к проекту — переменная появится в Environment Variables автоматически).
# Без токена загрузка файлов отвечает 503 «Хранилище не настроено», сборка не падает.
BLOB_READ_WRITE_TOKEN=""

# Stripe (apps/web) — booking payments via Stripe Checkout.
# STRIPE_SECRET_KEY: secret API key from https://dashboard.stripe.com/apikeys (sk_test_... locally)
# STRIPE_WEBHOOK_SECRET: signing secret of the webhook endpoint (whsec_...). Locally,
#   `stripe listen --forward-to localhost:3000/api/stripe/webhook` prints one.
# NEXT_PUBLIC_APP_URL: public base URL used for Checkout success/cancel redirects.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email notifications (apps/web) — Resend, https://resend.com/api-keys.
# RESEND_API_KEY: API key (re_...). Без ключа письма не отправляются: в лог пишется
#   "[email] skipped: ...", а сами запросы (заявки, брони, webhook) работают как обычно.
# EMAIL_FROM: адрес отправителя с подтверждённого в Resend домена,
#   например "SpecAI <noreply@example.com>". Для тестов подходит "onboarding@resend.dev".
RESEND_API_KEY=""
EMAIL_FROM="СпецПласт16 <noreply@example.com>"

# Admin area (/admin) with callback requests. Leave empty to disable it.
ADMIN_PASSWORD=""

# Optional: Telegram notifications about new callback requests.
# Create a bot with @BotFather, then get your chat id (e.g. via @userinfobot).
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
# Bot username without "@" for «Подключить Telegram» links (if empty, asked from Telegram).
NEXT_PUBLIC_TELEGRAM_BOT=""

# User notifications (lib/notifications). Push goes through exp.host and needs no key;
# EXPO_ACCESS_TOKEN only if "enhanced push security" is on in the Expo project.
EXPO_ACCESS_TOKEN=""
# WhatsApp via Green API (paid; empty = «скоро» in the settings).
GREEN_API_INSTANCE_ID=""
GREEN_API_TOKEN=""
GREEN_API_URL=""
# SMS via SMS.ru (paid; empty = «скоро»). SMSRU_FROM: approved sender name, optional.
SMSRU_API_ID=""
SMSRU_FROM=""

# Public site URL for canonical links, sitemap, QR and notification links; empty means
# https://иистройка24.рф (since 2026-10-24; spec-ai-web.vercel.app keeps the API and
# redirects its pages). iistroyka24.ru / iistroyka.ru are ignored until their
# DNS points at Vercel and NEXT_PUBLIC_SITE_DOMAIN_CONNECTED="1" is set.
NEXT_PUBLIC_SITE_URL=""
NEXT_PUBLIC_SITE_DOMAIN_CONNECTED=""

# Optional: Yandex.Metrika counter number for visit analytics.
NEXT_PUBLIC_YANDEX_METRIKA_ID=""

# Required for every /api/cron/* route: any long random string (32+ chars).
# Vercel sends it as "Authorization: Bearer …" for vercel.json crons; set the
# same value as the CRON_SECRET repository secret in GitHub (order-notices,
# bot-reminders workflows). Without it the cron routes answer 403.
CRON_SECRET=""

# Free automatic channels (docs/launch-plan.md, section 10).
# The platform's OWN Telegram channel for «Заявки на спецтехнику за сутки»: its
# @username or numeric id, after the bot (TELEGRAM_BOT_TOKEN) is made an admin
# there. Empty: no post.
TELEGRAM_CHANNEL_ID=""
# IndexNow key for Yandex/Bing (8–128 letters/digits, e.g. 32 hex characters).
# Empty: the key committed in public/ is used; "off" switches IndexNow off.
INDEXNOW_KEY=""

# Офис (lib/office/sources/dgis.ts): ключ 2ГИС Places API. По умолчанию источник ВЫКЛЮЧЕН.
# Постоянного тарифа без оплаты у 2ГИС нет — только разовый демо-ключ (1 месяц, 1 000 запросов,
# page_size до 10); контакты (items.contact_groups) — платное разрешение по запросу. Лицензия
# на API (law.2gis.ru, п. 3.1) запрещает извлекать и хранить данные, а офис их сохраняет.
# DGIS_STORAGE_ALLOWED=1 ставить ТОЛЬКО при договоре с 2ГИС, который разрешает хранить данные
# API; без обеих переменных поиск идёт только по OpenStreetMap. Законный путь собрать базу
# клиентов из 2ГИС — платная выгрузка «Дата.2ГИС».
DGIS_API_KEY=""
DGIS_STORAGE_ALLOWED=""

# Office agents (lib/office/smtp.ts): cold letters go ONLY from the office's own mailbox over SMTP
# (a Yandex 360 box on a separate domain, SPF/DKIM/DMARC set up), never through Resend. Empty user
# or password = the office prepares letters but sends none. Letters wait for the owner's «Отправить»
# in /admin/office/pisma unless the outreach mode is switched to automatic there.
OUTREACH_SMTP_HOST="smtp.yandex.ru"
OUTREACH_SMTP_PORT="465"
OUTREACH_SMTP_USER=""
OUTREACH_SMTP_PASS=""
OUTREACH_FROM=""
