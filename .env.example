# Postgres connection used by Prisma (packages/database).
# DATABASE_URL: used at runtime — point this at a pooled connection (e.g.
#   Neon's "-pooler" endpoint) in serverless deployments.
# DIRECT_URL: used for `prisma db push`/migrations — must be an unpooled
#   connection. Locally, with a single plain Postgres, both can be identical.
DATABASE_URL="postgresql://specai:specai@localhost:5432/specai?schema=public"
DIRECT_URL="postgresql://specai:specai@localhost:5432/specai?schema=public"

# Anthropic API key used by packages/ai-service
ANTHROPIC_API_KEY=""

# NextAuth (apps/web) — generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
